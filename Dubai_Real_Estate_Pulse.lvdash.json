{
  "datasets": [
    {
      "name": "6165c38b",
      "displayName": "Market Trends",
      "queryLines": [
        "-- CELL: Market Trends\n",
        "-- -----------------------------------------------------\n",
        "-- Produces dataset for Line Chart\n",
        "--\n",
        "SELECT\n",
        "    year,\n",
        "    month,\n",
        "    total_sales_aed,\n",
        "    CONCAT(year, '-', LPAD(month, 2, '0')) AS year_month\n",
        "FROM\n",
        "    gold_sales_overview\n",
        "ORDER BY\n",
        "    month"
      ]
    },
    {
      "name": "755259e3",
      "displayName": "Top Hotspots",
      "queryLines": [
        "-- CELL: Top Hotspots\n",
        "-- -----------------------------------------------------\n",
        "-- Produces dataset for Bar Chart\n",
        "--\n",
        "SELECT\n",
        "    area_name,\n",
        "    total_volume_aed\n",
        "FROM\n",
        "    gold_area_stats\n",
        "ORDER BY\n",
        "    total_volume_aed DESC\n",
        "    LIMIT 10"
      ]
    },
    {
      "name": "00bc3f54",
      "displayName": "Supply Inventory",
      "queryLines": [
        "-- CELL: Supply Inventory\n",
        "-- -----------------------------------------------------\n",
        "-- Produces dataset for Pie Chart\n",
        "--\n",
        "SELECT\n",
        "    room_type,\n",
        "    unit_count\n",
        "FROM\n",
        "    gold_supply_stats"
      ]
    }
  ],
